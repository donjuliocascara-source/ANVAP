rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /programaciones/{progId} {
      allow read, write: if true;
    }
    match /lotes/{loteId} {
      allow read, write: if true;
    }
    match /humedades/{id} {
      allow read, write: if true;
    }
    match /analisisHumedo/{id} {
      allow read, write: if true;
    }
    match /analisisSeco/{id} {
      allow read, write: if true;
    }
    match /presecados/{id} {
      allow read, write: if true;
    }
    match /batchesVaporizado/{id} {
      allow read, write: if true;
    }
    match /batchLotes/{id} {
      allow read, write: if true;
    }
    match /controlesVaporizado/{id} {
      allow read, write: if true;
    }
    match /analisisVaporizados/{id} {
      allow read, write: if true;
    }
    match /cocciones/{id} {
      allow read, write: if true;
    }
    match /auditLogs/{id} {
      allow read, write: if true;
    }
    match /systemConfig/{id} {
      allow read, write: if true;
    }
    match /users/{id} {
      allow read, write: if true;
    }
    match /priorizacionAudit/{id} {
      allow read, write: if true;
    }
    match /priorizacionConfigs/{id} {
      allow read, write: if true;
    }
    match /evaluacionConfigs/{id} {
      allow read, write: if true;
    }
    match /resultadosCoccionExternos/{id} {
      allow read, write: if true;
    }
    match /test/{id} {
      allow read, write: if true;
    }
  }
}
